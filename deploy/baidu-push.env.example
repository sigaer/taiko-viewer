# 百度搜索资源平台 → 普通收录 → 接口调用地址中的 token
# 复制为 deploy/baidu-push.env 后填写（该文件已在 .gitignore 中）
BAIDU_PUSH_SITE=https://viewer.sakura-bot.cn
# 推送接口 site 参数，填已验证域名（不要带 https://）；留空则从 BAIDU_PUSH_SITE 解析
BAIDU_PUSH_API_SITE=viewer.sakura-bot.cn
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITEMAP_URL=https://viewer.sakura-bot.cn/sitemap.xml
BAIDU_PUSH_BATCH_SIZE=2000
