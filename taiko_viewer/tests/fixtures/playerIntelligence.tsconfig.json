{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "strict": true,
    "baseUrl": "../..",
    "paths": { "~/*": ["./*"] },
    "skipLibCheck": true,
    "types": []
  },
  "include": ["../../utils/player-intelligence/*.ts"]
}
