[Unit]
Description=Taiko Sync Dispatcher (Sakura bot)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sigaer/taiko
Environment=PYTHONUNBUFFERED=1
Environment=TAIKO_SYNC_RECEIVER_HOST=127.0.0.1
Environment=TAIKO_SYNC_RECEIVER_PORT=3102
Environment="TAIKO_SYNC_RECEIVER_NAME=Sakura bot"
Environment=TAIKO_USERDATA_DIR=/home/sigaer/taiko/userdata
ExecStart=/home/sigaer/taiko/qa-vault/role-center-wf9putbr/venv/bin/python -I -m taiko_bot.services.sync_dispatch_server
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
