[Unit]
Description=Taiko Nuxt SSR (viewer.sakura-bot.cn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sigaer/taiko/taiko-forum/taiko_viewer
Environment=NODE_ENV=production
Environment=NITRO_PORT=3100
Environment=NITRO_HOST=127.0.0.1
EnvironmentFile=-/etc/taiko-viewer.env
Environment=TAIKO_REPO_ROOT=/home/sigaer/taiko
Environment=TAIKO_USERDATA_DIR=/home/sigaer/taiko/userdata
Environment=TAIKO_VIEWER_CACHE_DIR=/home/sigaer/taiko/data/viewer_cache
Environment=TAIKO_OPEN_RESOURCE_DIR=/home/sigaer/taiko-open-resources
Environment=TAIKO_OPEN_DAILY_LIMIT=100
Environment=TAIKO_OPEN_DEVELOPER_DAILY_LIMIT=2500
Environment=TAIKO_SUPPORT_INBOX=1106865024@qq.com
Environment=NUXT_PUBLIC_BAIDU_SITE_VERIFICATION=codeva-IokhumYAJv
Environment=BILIBILI_HTTP_PROXY=http://127.0.0.1:18888
Environment=BILIBILI_SESSDATA_FILE=/home/sigaer/bilisess.txt
ExecStart=/www/server/nvm/versions/node/v24.13.0/bin/node /home/sigaer/taiko/taiko-forum/taiko_viewer/.output/server/index.mjs
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
